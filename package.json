{
  "name": "pulse-win",
  "productName": "Pulse",
  "version": "0.1.1",
  "description": "Know how much your AI coding tools have left 鈥?a Windows port of Pulse (macOS), on the edge of your screen.",
  "main": "src/main/main.js",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "test-providers": "node scripts/test-providers.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.pulse.win",
    "productName": "Pulse",
    "compression": "normal",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "Pulse-${version}-win.exe"
    }
  }
}
